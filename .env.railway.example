# Variables para Railway (T21). Pegar en: servicio de la app > Variables > Raw Editor.
# NO poner contraseñas acá: este archivo se sube al repositorio.
# APP_KEY: generarla con  php artisan key:generate --show  y pegarla solo en Railway.
# DB_URL: Railway la completa sola con la referencia a su servicio MySQL.

APP_NAME="Reciclaje Comunitario"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

LOG_CHANNEL=stderr
LOG_LEVEL=info
